# Copy to .env and fill in. .env is gitignored.
APP_ANTHROPIC_API_KEY=

# Neo4j, as started by docker-compose.yml (credentials from the README)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# The chat server's address (optional): localhost:3000 by default. The chat spends the API
# key and has no login, so think twice before setting HOST to 0.0.0.0.
HOST=127.0.0.1
PORT=3000
