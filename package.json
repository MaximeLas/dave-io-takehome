{
  "name": "infra-knowledge-chat",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "serve": "npm run build && node --env-file-if-exists=.env dist/src/server/main.js",
    "test": "tsx --test --test-reporter=spec eval/*.test.ts src/*/*.test.ts",
    "check": "tsx --env-file-if-exists=.env scripts/check-setup.ts",
    "index": "tsx --env-file-if-exists=.env src/search/build-index.ts",
    "ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "simulate-gate": "tsx scripts/simulate-gate.ts"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "deepagents": "1.14.2",
    "langchain": "1.5.16",
    "neo4j-driver": "6.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
